# ==============================================================================
# CareerLens AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to version control.
# On AWS, provide these values via AWS Secrets Manager or ECS Task Environment.

# ------------------------------------------------------------------------------
# 1. LLM & Embeddings API Keys (Required)
# ------------------------------------------------------------------------------
# OpenAI API Key used for document embeddings (text-embedding-3-small)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key used for fast inference with LLaMA 3.3 70B (Interview, ATS, Gap Analysis)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Other LLM provider keys if configured
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Database Configuration (Required)
# ------------------------------------------------------------------------------
# Development SQLite default:
# DATABASE_URL=sqlite:///./career_lens.db
#
# Production AWS RDS PostgreSQL:
# DATABASE_URL=postgresql://<db_username>:<db_password>@<rds_endpoint>:5432/<db_name>
DATABASE_URL=sqlite:///./career_lens.db

# ------------------------------------------------------------------------------
# 3. Vector Database (ChromaDB)
# ------------------------------------------------------------------------------
# For local dev without Docker: host=localhost, port=8001
# For Docker Compose / AWS ECS: host=vector-db, port=8000
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_AUTO_START=true

# ------------------------------------------------------------------------------
# 4. Authentication & Security (Required)
# ------------------------------------------------------------------------------
# Secret key used for signing JWTs and session cookies (generate with `openssl rand -hex 32`)
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# 5. Network, Domain & CORS (Required for Production)
# ------------------------------------------------------------------------------
# Frontend / Public URL of your deployed application (e.g., https://careerlens.yourdomain.com)
FRONTEND_URL=http://localhost:8000

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# ------------------------------------------------------------------------------
# 6. File Storage
# ------------------------------------------------------------------------------
# Path where uploaded resumes (PDF, DOCX) are stored on the server
UPLOAD_DIR=uploads
